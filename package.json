{
  "name": "vulcan-web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser OPC UA client (UaExpert-style) via WebSocket — Vue 3 + Vite + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
